{
  "name": "dsh-lawcorpus",
  "version": "0.3.0",
  "private": true,
  "description": "法学论文框架语料库（DeepSeek Harness 插件）：内置近三年（2024–2026）四本 CLSCI 法学期刊 850 篇论文的题名、作者、摘要、关键词、目录骨架，支持 BM25 检索、体裁画像、框架卡抽取与投稿对标，全部离线、零依赖。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "law",
    "corpus",
    "academic-writing",
    "clsc"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
